// hardware group: cpu + memory + temperature + battery
{
    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory",
            "temperature",
            "battery"
        ]
    },
    "cpu": {
        "interval": 5,
        "format": "󰍛  {usage}%",
        "format-alt": "󰍛 {avg_frequency}GHz",
        "tooltip": true,
        "tooltip-format": "CPU Usage: {usage}%\nCores: {load}"
    },
    "memory": {
        "interval": 10,
        "format": "󰘚  {}%",
        "format-alt": "󰘚 {used:0.1f}G/{total:0.1f}G",
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}GB / {total:0.1f}GB\nSwap: {swapUsed:0.1f}GB / {swapTotal:0.1f}GB"
    },
    "temperature": {
        "interval": 5,
        "critical-threshold": 80,
        "format": "{icon}  {temperatureC}°C",
        "format-icons": [
            "󰜗",
            "󱃂",
            "󰸁"
        ]
    },
    "battery": {
        "interval": 30,
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}",
        "format-full": "{capacity}",
        "format-charging": "󰂄 {capacity}",
        "format-plugged": "󰚥 {capacity}",
        "format-alt": "{icon} {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip-format": "Battery: {capacity}%\n{timeTo}\nPower: {power}W"
    }
}
