// clock module — click toggles the quickshell Dynamic Island calendar
{
    "clock": {
        "format": "{:%I:%M %p      %a  %d  %b}",
        // "format-alt": "{:%Y-%m-%d   %H:%M:%S}",
        "on-click": "quickshell ipc call island toggle",
        "on-click-right": "quickshell ipc call island toggle",
        "on-click-middle": "quickshell ipc call island toggle",
        // Native hover calendar removed — the Dynamic Island is the date popup now.
        "tooltip": false
    }
}
