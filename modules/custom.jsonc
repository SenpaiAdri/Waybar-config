// custom modules: power + notification + profile
{
    "custom/power": {
        "format": "󰐥",
        "tooltip": true,
        "tooltip-format": "Power menu",
        "on-click": "~/.config/waybar/scripts/power-menu.sh"
    },
    "custom/notification": {
        "tooltip": true,
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/notification-status.sh",
        "interval": 2,
        "on-click": "quickshell ipc call notifs toggle",
        "on-click-right": "quickshell ipc call notifs dnd"
    },
    "custom/profile": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/power-profile.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "~/.config/waybar/scripts/power-profile.sh next && pkill -SIGRTMIN+8 waybar",
        "signal": 8
    }
}
