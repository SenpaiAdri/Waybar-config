// custom modules: power + notification + profile
{
    "custom/control-center": {
        "format": "⌘",
        "tooltip-format": "Control Center",
        "on-click": "~/.config/waybar/scripts/popup.sh controls"
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": true,
        "tooltip-format": "Power menu",
        "on-click": "~/.config/waybar/scripts/power-menu.sh"
    },
    "custom/notification": {
        "tooltip": true,
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/notification-status.sh",
        "interval": 2,
        "on-click": "~/.config/waybar/scripts/popup.sh notifs",
        "on-click-right": "quickshell ipc call notifs dnd"
    },
    "custom/profile": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/power-profile.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "~/.config/waybar/scripts/power-profile.sh toggle; pkill -u \"$(id -u)\" -SIGRTMIN+8 -x waybar",
        "on-click-right": "~/.config/waybar/scripts/power-profile.sh cycle; pkill -u \"$(id -u)\" -SIGRTMIN+8 -x waybar",
        "signal": 8
    }
}
