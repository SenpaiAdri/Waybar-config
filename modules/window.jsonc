// hyprland/window module
{
    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true,
        "format": "  {}",
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹  $1",
            "(.*) - Brave": "  $1",
            "(.*) - Cursor": "  $1",
            "(.*) - Visual Studio Code": "󰨞  $1",
            "": "  Desktop"
        }
    }
}
