// -*- mode: jsonc -*-
// Waybar — modular config. Bar layout lives here, modules in ./modules/.
{
    "include": [
        "~/.config/waybar/modules/workspaces.jsonc",
        "~/.config/waybar/modules/window.jsonc",
        "~/.config/waybar/modules/clock.jsonc",
        "~/.config/waybar/modules/hardware.jsonc",
        "~/.config/waybar/modules/multimedia.jsonc",
        "~/.config/waybar/modules/tray.jsonc",
        "~/.config/waybar/modules/custom.jsonc"
    ],
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 10,
    "margin-top": 4,
    "margin-bottom": 0,
    "margin-left": 10,
    "margin-right": 10,
    // --- MODULES LEFT ---
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    // --- MODULES CENTER ---
    "modules-center": [
        "clock"
    ],
    // --- MODULES RIGHT ---
    "modules-right": [
        "custom/profile",
        "group/multimedia",
        "group/hardware",
        "tray",
        "custom/notification",
        "custom/power"
    ]
}
